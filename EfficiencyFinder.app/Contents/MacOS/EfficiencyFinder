#!/bin/bash
# Double-click launcher. Runs one-time setup automatically on first launch.

set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
PROJECT="$(cd "$HERE/../../.." && pwd)"
PYTHON="$PROJECT/.venv/bin/python"
MAIN="$PROJECT/main.py"
SETUP="$PROJECT/scripts/first_run_setup.sh"

if [[ ! -f "$MAIN" ]]; then
  osascript -e "display dialog \"EfficiencyFinder could not find main.py.

Keep EfficiencyFinder.app in the project folder (next to main.py).\" buttons {\"OK\"} default button 1 with icon stop with title \"EfficiencyFinder\""
  exit 1
fi

if [[ ! -x "$SETUP" ]]; then
  osascript -e "display dialog \"Setup script missing:

$SETUP\" buttons {\"OK\"} default button 1 with icon stop with title \"EfficiencyFinder\""
  exit 1
fi

# First launch (or broken venv): install dependencies automatically.
if ! bash "$SETUP" "$PROJECT" --check-only; then
  bash "$SETUP" "$PROJECT" || exit 1
fi

cd "$PROJECT"
export PYTHONUNBUFFERED=1
exec "$PYTHON" "$MAIN"
