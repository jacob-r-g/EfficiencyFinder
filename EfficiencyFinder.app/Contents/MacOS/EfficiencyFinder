#!/bin/bash
# Optional Finder shortcut. Prefer Setup EfficiencyFinder.command to open the app.

set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
PROJECT="$(cd "$HERE/../../.." && pwd)"
LAUNCH="$PROJECT/scripts/launch_app.sh"
DIALOG="$PROJECT/scripts/macos_dialog.sh"

if [[ ! -f "$LAUNCH" ]]; then
  if [[ -f "$DIALOG" ]]; then
    # shellcheck source=macos_dialog.sh
    source "$DIALOG"
    macos_alert_error "Please use Setup EfficiencyFinder.command to open EfficiencyFinder.

Keep EfficiencyFinder.app inside the project folder next to main.py."
  fi
  exit 1
fi

EFFICIENCYFINDER_ROOT="$PROJECT" exec bash "$LAUNCH"
