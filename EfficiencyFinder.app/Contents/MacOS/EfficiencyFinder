#!/bin/bash
# Finder / Dock launcher. Finds the real project folder even if macOS
# temporarily copied this .app (App Translocation).

set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
SCRIPTS="$(cd "$HERE/../../../scripts" 2>/dev/null && pwd || true)"

# Prefer scripts next to a non-translocated copy via saved path.
if [[ -f "${HOME}/Library/Application Support/EfficiencyFinder/install_root.txt" ]]; then
  ROOT="$(<"${HOME}/Library/Application Support/EfficiencyFinder/install_root.txt")"
  if [[ -f "$ROOT/scripts/launch_app.sh" ]]; then
    exec bash "$ROOT/scripts/launch_app.sh" "$ROOT"
  fi
fi

if [[ -n "$SCRIPTS" && -f "$SCRIPTS/launch_app.sh" && "$HERE" != *AppTranslocation* ]]; then
  exec bash "$SCRIPTS/launch_app.sh" "$HERE/../../.."
fi

# Last resort: search common locations.
for candidate in \
  "/Applications/EfficiencyFinder" \
  "${HOME}/Applications/EfficiencyFinder" \
  "${HOME}/Desktop/EfficiencyFinder" \
  "${HOME}/Downloads/EfficiencyFinder"; do
  if [[ -f "$candidate/scripts/launch_app.sh" ]]; then
    exec bash "$candidate/scripts/launch_app.sh" "$candidate"
  fi
done

osascript -e 'display dialog "Please double-click Setup EfficiencyFinder.command in the EfficiencyFinder folder (the folder that also contains main.py)." buttons {"OK"} default button 1 with title "EfficiencyFinder" with icon note' >/dev/null
exit 1
